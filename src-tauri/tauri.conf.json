{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BongoStock",
  "version": "../package.json",
  "identifier": "com.bongostock.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "BongoStock",
        "url": "index.html/#/",
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "maximizable": false
      },
      {
        "label": "preference",
        "url": "index.html/#/preference",
        "create": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 800,
        "minHeight": 600,
        "skipTaskbar": false
      },
      {
        "label": "stock-panel",
        "title": "BongoStock 行情",
        "url": "index.html/#/stock-panel",
        "create": false,
        "visible": false,
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "width": 270,
        "height": 180
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' https://smartbox.gtimg.cn https://searchapi.eastmoney.com; connect-src 'self' asset: ipc: http://asset.localhost https://*.gtimg.cn https://*.eastmoney.com https://*.sina.cn; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:;",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$RESOURCE/assets/models/**", "$APPDATA/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "shortDescription": "A discreet stock-watching desktop pet",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["assets/tray.png", "assets/models"]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
